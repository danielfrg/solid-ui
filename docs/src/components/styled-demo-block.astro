---
import DemoBlock from "./demo-block.astro"

interface DemoFile {
  label: string
  code: string
}

interface Props {
  files: DemoFile[]
  defaultOpen?: boolean
  label?: string
}

const { files, defaultOpen = false, label = "Source" } = Astro.props
---

<DemoBlock files={files} defaultOpen={defaultOpen} label={label}>
  <slot />
</DemoBlock>
