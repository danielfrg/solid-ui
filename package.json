{
  "name": "danielfrg-solid-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:docs": "pnpm --filter docs dev",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --config oxlint.config.json",
    "test": "vitest",
    "test:run": "vitest --run --reporter=dot",
    "typecheck": "tsc -p packages/ui/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.6",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/node": "^25.5.0",
    "jsdom": "^24.0.0",
    "solid-js": "^1.8.15",
    "typescript-language-server": "^5.1.3",
    "vite": "^5.0.11",
    "vite-plugin-solid": "^2.9.1",
    "vitest": "^1.3.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
